# =============================================================================
# Docker Environment Configuration Template
# =============================================================================
# Copy this file to .env before running `docker compose up --build`
# Fill in your own secure values. Never commit actual production secrets.

# Environment: production or development
ENVIRONMENT=production
DEBUG=false

# Secret Key for JWT & CSRF signing (generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_string_of_at_least_32_characters

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_db_password
POSTGRES_DB=portfolio_db
POSTGRES_PORT=5433

# CORS Configuration (JSON array string or comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# Cookies (Set to true in production with HTTPS / SSL)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Ports for Local Testing
BACKEND_PORT=8001
FRONTEND_PORT=3001

# Next.js API URLs
NEXT_PUBLIC_API_URL=http://localhost:8001
INTERNAL_API_URL=http://backend:8000
