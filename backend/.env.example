# Application
APP_NAME=Shabnum H. Portfolio API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# CORS (comma-separated or JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# PostgreSQL Database
# Option A: Provide a full SQLAlchemy URL (takes precedence if set)
# DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/portfolio_db
# Option B: Provide discrete PostgreSQL connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=portfolio_db

# SQLAlchemy Engine Pool Settings
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication (Phase 2)
# Generate a strong random secret (minimum 32 characters), e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_BEFORE_PHASE_2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth Cookies & CSRF
REFRESH_COOKIE_NAME=portfolio_refresh_token
CSRF_COOKIE_NAME=portfolio_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# Leave COOKIE_SECURE unset to auto-enable in staging/production and disable in local HTTP development
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Login Rate Limiting
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
